+
+impl SparseObservation {
+    fn cell(&mut self, plane: usize, at: Square, value: f32) {
+        if value != 0.0 {
+            self.indices.push(plane * BOARD_CELLS + square_index(at));
+            self.values.push(value);
+        }
+    }
+    fn plane(&mut self, plane: usize, value: f32) {
