{
  "name": "simultaneous-shogi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dashboard": "node dashboard/launcher.mjs",
    "dashboard:server": "node dashboard/server.mjs",
    "ai:setup:gpu": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File dashboard/setup-gpu.ps1",
    "ai:build": "cargo build -p shogi-cli --release --locked --target-dir target/balance",
    "ai:balance": ".venv/Scripts/python.exe -m training.experiments",
    "ai:colab": "node scripts/build-colab.mjs",
    "ai:benchmark": "node scripts/benchmark-actions.mjs",
    "ai:benchmark:training": "node scripts/benchmark-training.mjs",
    "test:dashboard": "node scripts/verify-dashboard.mjs",
    "test:history": "node scripts/verify-history.mjs",
    "test:balance": "node scripts/verify-balance-dashboard.mjs",
    "test:training": "node scripts/test-training.mjs",
    "test:external": "node scripts/verify-external-dashboard.mjs",
    "test:gpu": "node scripts/verify-gpu.mjs",
    "test:launcher": "node scripts/verify-launcher.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "node scripts/build-web.mjs",
    "docs:rule-gifs": "node scripts/build-rule-gifs.mjs",
    "build": "npm run build:wasm && npm run build:web",
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/verify.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:online": "node scripts/verify-online.mjs",
    "test:server": "node --test scripts/verify-server.mjs",
    "test:models": "node scripts/verify-models.mjs",
    "test:external-play": "node scripts/verify-external-play.mjs",
    "test:play-rules": "node scripts/verify-play-rules.mjs",
    "test:auras": "node scripts/verify-auras-browser.mjs",
    "test:rule-demos": "node scripts/verify-rule-demos.mjs --browser",
    "test:browser": "node scripts/verify-browser.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "gifenc": "1.0.3",
    "happy-dom": "20.14.6",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
